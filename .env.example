# ブラウザから開くホスト側ポート
PORT=8080

# 127.0.0.1 のままなら、このPCからだけアクセスできます。
# LAN内へ公開する場合だけ 0.0.0.0 に変更してください。
HOST_IP=127.0.0.1

LOG_LEVEL=INFO
MAX_REQUEST_BYTES=2097152
MAX_RESPONSE_BYTES=10485760
# MAX_PROXY_ENVELOPE_BYTES=8912896

# リバースプロキシ配下で使う場合の例:
# TRUST_PROXY_HEADERS=true
# ALLOWED_ORIGINS=https://postman.example.local
