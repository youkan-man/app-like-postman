{
  "version": 1,
  "relay_environment": "kip-n02",
  "environment_revision": "minipost-published-url-20261014-v1",
  "vms": {
    "app": {
      "port": 8080
    },
    "probe": {
      "port": 8080
    }
  },
  "steps": [
    {
      "name": "minipost-launch",
      "vm": "app",
      "run": "python3 -m py_compile app.py network.py ci/sandbox_published_url_smoke.py && python3 ci/sandbox_published_url_smoke.py launch"
    },
    {
      "name": "verify-issued-app-url",
      "vm": "probe",
      "needs": [
        "minipost-launch"
      ],
      "run": "python3 ci/sandbox_published_url_smoke.py verify"
    },
    {
      "name": "minipost-stop",
      "vm": "app",
      "needs": [
        "verify-issued-app-url"
      ],
      "run": "python3 ci/sandbox_published_url_smoke.py stop"
    }
  ]
}
