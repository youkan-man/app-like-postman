{
  "version": 1,
  "packages": {"apt": ["ca-certificates", "nodejs", "openssl", "python3", "python3-venv", "python3-pip"]},
  "vms": {
    "app": {"port": 8080, "resources": {"disk_gib": 8}},
    "browser": {"port": 18081, "resources": {"disk_gib": 8}}
  },
  "steps": [
    {"name": "start-app", "vm": "app", "needs": [], "run": "bash ci/relay_2vm_start_app.sh"},
    {"name": "prepare-browser", "vm": "browser", "needs": [], "run": "bash ci/relay_2vm_prepare_browser.sh"},
    {"name": "public-entry-e2e", "vm": "browser", "needs": ["start-app", "prepare-browser"], "run": "mkdir -p .local_relay/output && ARTIFACT_DIR=.local_relay/output PLAYWRIGHT_BROWSERS_PATH=/opt/minipost-playwright /opt/minipost-e2e-venv/bin/python tests/ui_public_entry.py >.local_relay/output/public-entry.log 2>&1"}
  ],
  "environment_revision": "minipost-send-public-entry-20261029"
}
