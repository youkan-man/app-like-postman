  "scripts": [
    {
      "id": "mp-1795139450023-d1g2dbwuyxk",
      "name": "子集計",
      "source": "const value=ribbon.get('main.count')*2; ribbon.set('main.result',{value}); return value;",
      "input": "null",
      "inputFormat": "json",
      "timeoutMs": 0
    },
    {
      "id": "mp-1795139450743-pro9cbx2xc",
      "name": "リボン集計",
      "source": "const value=await scripts.run(\"mp-1795139450023-d1g2dbwuyxk\",input); store.set(\"event\",input); store.set(\"runs\",(store.get(\"runs\")||0)+1); return value;",
      "input": "null",
      "inputFormat": "json",
      "timeoutMs": 0
    },
    {
      "id": "mp-1795139451389-t3mrl975ws",
      "name": "変更を一度だけ処理",
      "source": "store.set('changes',(store.get('changes')||0)+1); store.set('previousCount',input.previousValue); ribbon.set('main.count',input.value+1);",
      "input": "null",
      "inputFormat": "json",
      "timeoutMs": 0
    },
    {
      "id": "mp-1795139451990-kfj0mbngnwr",
      "name": "失敗する処理",
      "source": "ribbon.set('main.count',999); store.set('failedWrite',true); throw Error('ribbon failure');",
      "input": "null",
      "inputFormat": "json",
      "timeoutMs": 0
    }
  ],
